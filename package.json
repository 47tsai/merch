    "verify:category": "node scripts/verify-category-contract.mjs",
    "verify:images": "node scripts/verify-image-contract.mjs",
    "verify:statistics": "node scripts/verify-statistics-date.mjs",
    "verify:statistics-year": "node scripts/verify-statistics-year-isolation.mjs",
    "verify:statistics-year-contract": "node scripts/verify-statistics-year-contract.mjs",
    "verify:management-schema": "node scripts/verify-management-schema.mjs",
